{
  "name": "lms-ueu-backend",
  "version": "1.0.0",
  "description": "MOOC Esa Unggul Backend API - Node.js/TypeScript",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "migrate:latest": "tsx node_modules/knex/bin/cli.js --knexfile src/db/knexfile.ts migrate:latest",
    "migrate:rollback": "tsx node_modules/knex/bin/cli.js --knexfile src/db/knexfile.ts migrate:rollback",
    "migrate:status": "tsx node_modules/knex/bin/cli.js --knexfile src/db/knexfile.ts migrate:status",
    "migrate:make": "tsx node_modules/knex/bin/cli.js --knexfile src/db/knexfile.ts migrate:make",
    "seed:run": "tsx node_modules/knex/bin/cli.js --knexfile src/db/knexfile.ts seed:run",
    "seed:make": "tsx node_modules/knex/bin/cli.js --knexfile src/db/knexfile.ts seed:make"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "argon2": "^0.31.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "nodemailer": "^8.0.5",
    "pg": "^8.11.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd"
}
